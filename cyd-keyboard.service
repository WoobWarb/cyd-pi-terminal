[Unit]
Description=CYD Keyboard Forwarder (physical keyboard -> Xvfb :1)
After=cyd-screen.service
Wants=cyd-screen.service

[Service]
Type=simple
User=root
Environment=DISPLAY=:1
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/sleep 2
ExecStart=/home/deathwolf/cyd-screen/venv/bin/python -u /home/deathwolf/cyd-screen/keyboard_forwarder.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
